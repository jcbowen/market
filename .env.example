# 环境变量示例
#
# 复制本文件为 .env 后按需修改。
# docker-compose.yml 会自动读取 .env：MYSQL_ROOT_PASSWORD / REDIS_PASSWORD 缺失时拒绝启动；
# Go 服务启动时经 common/config.ApplyEnvOverrides 覆盖配置文件中的空占位。

# ============== Docker 基础设施口令（必填，docker-compose.yml 引用）==============
# 上线前必须更换为随机强口令——旧口令 market123 已随 git 历史泄漏
MYSQL_ROOT_PASSWORD=change-this-to-a-strong-password
REDIS_PASSWORD=change-this-to-a-strong-password

# ============== Docker 外部数据库模式 ==============
# 使用 docker-compose.external-db.yml 时，请同步修改 bin/config.docker.yaml 对应项：
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=market
DB_USER=root
DB_PASSWORD=your-mysql-password

REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ============== JWT 密钥（必填，不区分环境）==============
# 密钥为空、等于入库的默认占位串或短于 32 位时，所有服务一律拒绝启动（fail-fast）。
# 默认占位串随 git 公开，任何持有者都能据此伪造超管 token，故不再只在生产环境检查。
# 生成方式（跨平台任选）：
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 纯本地开发想跳过校验：JWT_ALLOW_INSECURE_DEV=true（严禁用于生产/演示环境）
APP_ENV=production
JWT_SECRET=

# ============== 反向代理与限流（仅 gateway 读取）==============
# 可信代理网段：逗号分隔的 CIDR 或单个 IP，决定 ClientIP 是否采信 X-Forwarded-For。
# 生产用宿主 nginx 反代容器发布端口时必填 compose 网络实际网段
#   （docker network inspect market_default 取 Configurations.Subnet，例如 172.18.0.0/16）。
# 留空 = 不信任任何代理（按直连 IP 处理，此时所有用户会共用一个限流桶，需与 nginx 同机场景自行判断）；
# 严禁填 0.0.0.0/0 —— 任何人都能伪造头绕过按 IP 的限流与登录锁定。
TRUSTED_PROXIES=

# 部署域名基址（仅 gateway 读取）：形如 https://shop.example.com，只到域名（可带端口），不含路径与尾斜杠。
# 设置后**优先于**后台「系统管理 → 站点设置」里的部署域名，支付回调地址、附件外链与 HTML 品牌注入都按它派生。
# 适用场景：多环境共用同一份数据备份、或希望把域名固定在部署层而不随库走。
# 留空则以站点设置为准；两者都空时按当前请求域名现推（回调地址会随访问 host 变化，正式上线务必二选一固定）。
SITE_BASE_URL=

# ============== 一体化镜像（all-in-one）可选配置 ==============
# 使用 src/backend/deploy/Dockerfile.allinone 构建的镜像时，经 docker run -e 注入。
# 初始超管账号（仅首次初始化生效；密码缺省时随机生成并输出到容器启动日志，
# 事后可用 docker exec -it <容器名> ./market-admin 查看/重置）：
# MARKET_ADMIN_USER=admin
# MARKET_ADMIN_PASSWORD=

# ============== 域名与 SSL ==============
DOMAIN=your-domain.com
ENABLE_SSL=false
CERT_PATH=/app/ssl/cert.pem
KEY_PATH=/app/ssl/key.pem
