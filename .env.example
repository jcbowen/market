# 环境变量示例
#
# 复制本文件为 .env 后按需修改。
# docker-compose.yml 会自动读取 .env：MYSQL_ROOT_PASSWORD / REDIS_PASSWORD 缺失时拒绝启动；
# Go 服务启动时经 common/config.ApplyEnvOverrides 覆盖配置文件中的空占位。

# ============== Docker 基础设施口令（必填，docker-compose.yml 引用）==============
# 上线前必须更换为随机强口令——旧口令 market123 已随 git 历史泄漏
MYSQL_ROOT_PASSWORD=change-this-to-a-strong-password
REDIS_PASSWORD=change-this-to-a-strong-password

# ============== Docker 外部数据库模式 ==============
# 使用 docker-compose.external-db.yml 时，请同步修改 bin/config.docker.yaml 对应项：
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=market
DB_USER=root
DB_PASSWORD=your-mysql-password

REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ============== JWT 密钥（生产环境必填）==============
# APP_ENV=production 时若 JWT 密钥仍为默认占位串，服务将拒绝启动（fail-fast）
APP_ENV=production
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars

# ============== 域名与 SSL ==============
DOMAIN=your-domain.com
ENABLE_SSL=false
CERT_PATH=/app/ssl/cert.pem
KEY_PATH=/app/ssl/key.pem
