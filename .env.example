# 环境变量示例（全集）
#
# 复制本文件为 .env 后按需修改；带值的行为默认示例，注释掉（# 开头）的是可选项，
# 未设置的变量一律走安全默认（配置文件占位 / 代码内置默认值）。
#
# .env 的三种读取方：
#   1) docker compose（含 node start-all.mjs，本地一键启动走 docker compose up -d）
#      —— compose 自动读取项目根目录 .env 做变量替换，注入容器环境；
#   2) Go 服务进程 —— 启动时经 common/config.ApplyEnvOverrides 用环境变量
#      覆盖配置文件中的空占位（仅下列「服务凭据/网关/调试」类变量生效）；
#   3) 单容器 all-in-one 镜像 —— docker run -e 逐项注入（不经 .env 文件），
#      部署示例见 docs/需求文档/10-部署方案/03-生产环境部署.md。
#
# 注意：.env 只在 docker compose / start-all 场景自动生效；直接 go run 或跑
#       编译产物时须设置真实的进程环境变量（PowerShell: $env:JWT_SECRET="x"）。

# ============== 一、Docker 基础设施口令（必填）==============
# docker-compose.yml 与 start-all.mjs 均强制要求，缺失时拒绝启动；
# 单容器 all-in-one 镜像的 entrypoint 同样校验这两项，且 MYSQL_ROOT_PASSWORD
# 会兼任业务库口令（entrypoint 自动导出为 MYSQL_PASSWORD）。
# 上线前必须更换为随机强口令——旧口令 market123 已随 git 历史泄漏
MYSQL_ROOT_PASSWORD=change-this-to-a-strong-password
REDIS_PASSWORD=change-this-to-a-strong-password

# ============== 二、服务凭据 ==============
# JWT 签名密钥（compose 部署必填，不区分环境）：
# 为空、等于入库的默认占位串或短于 32 位时，所有服务一律拒绝启动（fail-fast）。
# 默认占位串随 git 公开，任何持有者都能据此伪造超管 token。
# 例外：单容器 all-in-one 镜像可留空——entrypoint 首次启动随机生成并持久化到
# /app/runtime/jwt_secret（随 bind mount 落宿主机，容器重建不使既有 token 失效）。
# 生成方式（跨平台任选）：
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 纯本地开发想跳过上述 JWT 校验（用默认占位密钥跑通即可）时置 true；
# 严禁用于生产/演示环境
# JWT_ALLOW_INSECURE_DEV=true
# 运行环境标识：production 时 IsProduction 判定为生产（start-all 据此跳过
# 开发测试数据导入，deploy/init.dev.sql 含弱口令账号，生产严禁导入）。
# 本地留空/不设置 = 非生产；线上部署务必设 production
# APP_ENV=production

# ============== 三、外部数据库模式（docker-compose.external-db.yml）==============
# 使用外部 MySQL/Redis 时改用该 compose 文件启动，凭据与连接拓扑全部经 .env 注入
# （ApplyEnvOverrides 覆盖配置占位），无需手改入库的 bin/config.docker.yaml。
# 口令（必填，缺失拒绝启动）：
# MYSQL_PASSWORD=your-external-mysql-password
# REDIS_PASSWORD=your-external-redis-password
# 连接拓扑（DB_HOST / REDIS_HOST 必填——该模式下容器内无数据库，
# config.docker.yaml 的默认 host 指向内部服务名 mysql/redis，不经覆盖必连错；
# 端口/库名/用户留空走默认 3306/market/root 与 6379/0）：
# DB_HOST=your-mysql-host
# DB_PORT=3306
# DB_NAME=market
# DB_USER=root
# REDIS_HOST=your-redis-host
# REDIS_PORT=6379
# REDIS_DB=0

# ============== 四、网关行为（仅 gateway 读取）==============
# 可信代理网段：逗号分隔的 CIDR 或单个 IP，决定 ClientIP 是否采信 X-Forwarded-For。
# 生产用宿主 nginx 反代容器发布端口时必填 compose 网络实际网段
#   （docker network inspect market_default 取 Configurations.Subnet，例如 172.18.0.0/16）。
# 留空 = 不信任任何代理（按直连 IP 处理，此时所有用户会共用一个限流桶，需与 nginx 同机场景自行判断）；
# 严禁填 0.0.0.0/0 —— 任何人都能伪造头绕过按 IP 的限流与登录锁定。
# TRUSTED_PROXIES=172.18.0.0/16
# 可信平台专用头名（如前置阿里云 CDN 时填 Ali-CDN-Real-IP）：
# 该头由 CDN 强制覆盖写入、客户端伪造无效，ClientIP 优先采信；留空 = 不启用
# TRUSTED_PLATFORM=Ali-CDN-Real-IP
# 部署域名基址：形如 https://shop.example.com，只到域名（可带端口），不含路径与尾斜杠。
# 作为后台「系统管理 → 站点设置」未配置时的兜底默认值：站点设置页会把该值回填进输入框，
# 在页面保存后即以站点设置为准（支付回调地址、附件外链与 HTML 品牌注入按生效域名派生）。
# 适用场景：新环境首次启动、尚未进后台配置时先固定一个域名，避免回调地址随访问 host 漂移。
# 留空且站点设置也未配置时按当前请求域名现推（回调地址会随访问 host 变化，正式上线务必二选一固定）。
# SITE_BASE_URL=https://shop.example.com

# ============== 五、调试页面（debugger，临时排查用，默认关闭）==============
# 请求日志组件开关：1 或 true（忽略大小写）= 开，其余非空值 = 关；
# 留空 = 沿用配置文件 debugger.enabled（发布模板默认 false，勿随发布包默认开启）。
# 注意只开此项不给白名单时页面路由不注册（fail-closed），只记请求日志
# DEBUGGER_ENABLED=1
# 调试页面访问白名单（逗号分隔 IP/CIDR，经 gin ClientIP 校验）；
# 临时排查须与 DEBUGGER_ENABLED 两项齐给：DEBUGGER_ENABLED=1 + DEBUGGER_ALLOWED_IPS=<你的出口IP>
# DEBUGGER_ALLOWED_IPS=127.0.0.1
# debug_logs 日志来源标识（多服务共享 debug_logs 表时区分来源，前端可按服务筛选）：
# 容器部署已自动处理（compose 各服务共用模板由 entrypoint/allinone 覆写），一般无需设置
# DEBUGGER_SERVICE_NAME=gateway

# ============== 六、单容器 all-in-one 初始化（docker run -e 注入）==============
# 仅生产单容器镜像（src/backend/deploy/Dockerfile.allinone）使用，
# compose 部署无需配置；均只影响首次初始化，幂等不覆盖既有数据。
# 初始超管用户名（默认 admin；与既有账号重名且非超管时拒绝初始化）
# MARKET_ADMIN_USER=admin
# 初始超管密码（至少 8 位，过短拒绝初始化）；
# 缺省时随机生成 16 位并输出到容器启动日志（docker logs 可查），
# 事后可用 docker exec -it <容器名> ./market-admin 查看/重置
# MARKET_ADMIN_PASSWORD=
# 初始默认社区名称（默认「默认社区」）
# MARKET_DEFAULT_COMMUNITY=默认社区

# ============== 七、后台版本检查（gateway 更新检查源）==============
# 覆盖检查更新用的镜像仓库（默认 jcbowen/market）；设为 off/none/disable
# （不区分大小写）可关闭对应源的检查
# DOCKERHUB_REPO=jcbowen/market
# GHCR_REPO=jcbowen/market
# Docker Hub Registry API 基地址（默认官方 https://hub.docker.com/v2/repositories/，
# 国内网络不通时可指向镜像代理）
# DOCKERHUB_API_BASE=

# ============== 八、进阶项（一般无需手动设置）==============
# 配置文件路径覆盖（默认随工作目录解析；容器 entrypoint 已为每个进程注入私有副本）
# CONFIG_FILE=
# 超管初始化凭证输出文件路径（entrypoint 已注入 /app/runtime/admin_credentials.json）
# MARKET_ADMIN_CREDENTIALS_FILE=

# ============== 九、本地 Go 集成测试（go test 用，与运行时无关）==============
# TEST_MYSQL_PASSWORD / TEST_REDIS_PASSWORD 未设置时集成测试自动 skip（纯函数测试照常跑）；
# 其余 TEST_* 项均有默认值（127.0.0.1:3306/6379、库名 market、用户 root），按需覆盖。
# 本地跑测试通常配合 start-all 起的 docker 栈，密码与 .env 第一节一致：
# TEST_MYSQL_PASSWORD=change-this-to-a-strong-password
# TEST_REDIS_PASSWORD=change-this-to-a-strong-password
# TEST_MYSQL_HOST=127.0.0.1
# TEST_MYSQL_PORT=3306
# TEST_MYSQL_DBNAME=market
# TEST_MYSQL_USER=root
# TEST_REDIS_HOST=127.0.0.1
# TEST_REDIS_ADDR=127.0.0.1:6379
