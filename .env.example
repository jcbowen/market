# 环境变量示例
#
# 复制本文件为 .env 后按需修改。
# 当前项目配置主要读取 YAML 文件，.env 仅用于记录部署时需要关注的外部依赖信息。

# ============== Docker 外部数据库模式 ==============
# 使用 docker-compose.external-db.yml 时，请同步修改 bin/config.docker.yaml 对应项：
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=market
DB_USER=root
DB_PASSWORD=your-mysql-password

REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ============== JWT 密钥（生产环境务必修改）=============
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars

# ============== 域名与 SSL ==============
DOMAIN=your-domain.com
ENABLE_SSL=false
CERT_PATH=/app/ssl/cert.pem
KEY_PATH=/app/ssl/key.pem
