# 微服务通用镜像
# 仅打包已编译的二进制产物，不编译源码
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

# 非 root 运行：容器内以固定 UID 10001 运行服务进程，
# 即使服务被攻破也难以逃逸获得容器 root 权限
RUN adduser -D -u 10001 appuser

WORKDIR /app

# 通过构建参数指定服务名，从宿主机 bin/linux-{arch} 目录复制预编译二进制
# （build.mjs 按 bin/{os}-{arch}/ 布局输出，amd64/arm64 由 BuildKit 的
#  TARGETARCH 自动注入：Docker Desktop/服务器按目标平台取对应产物）
ARG SERVICE_NAME
ARG TARGETARCH
COPY bin/linux-${TARGETARCH}/${SERVICE_NAME}-service ./service

# 服务 gRPC 监听端口：5 个微服务共用本 Dockerfile，但各自监听 50051~50055
# （与 bin/config.docker.yaml 的 *_service.grpc_port 同源），端口由
# docker-compose.yml build.args 逐服务传入，确保健康检查探测端口与实际一致
ARG SERVICE_PORT=50051
ENV SERVICE_PORT=${SERVICE_PORT}

RUN chmod +x ./service && chown -R appuser:appuser /app

USER appuser

# 配置文件通过运行时 volume 挂载，不打包进镜像
EXPOSE ${SERVICE_PORT}

# 健康检查：gRPC 端口 TCP 探活（busybox nc）；
# shell 形式在容器运行时展开 ENV SERVICE_PORT，与镜像内服务实际监听端口一致
# start-period/retries 与 Dockerfile.app 对齐（120s + 10 次）：gRPC 端口在 AutoMigrate
# 之后才监听，全新空库首启要建 60+ 张表，原 15s+5×10s≈65s 的预算会把「正在正常迁移」
# 的服务判成 unhealthy，进而让 compose 的 service_healthy 依赖门（gateway 等下游）失效
HEALTHCHECK --interval=10s --timeout=3s --retries=10 --start-period=120s \
    CMD nc -z 127.0.0.1 ${SERVICE_PORT} || exit 1

CMD ["./service"]
