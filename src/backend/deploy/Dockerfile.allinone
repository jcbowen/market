# market 一体化镜像（all-in-one）
# 单容器运行 MySQL 8.0 + Redis 7 + gateway + 五个微服务 + 前端静态资源，
# 对外仅发布 18080；MySQL/Redis 监听 0.0.0.0 供端口映射调试（发布侧绑定
# 宿主机 127.0.0.1，不对公网暴露），数据全部经宿主机 bind mount 持久化（重装镜像不丢数据）。
#
# 构建前提：先执行 `node build.mjs` 产出 bin/linux-{amd64,arm64} 与 bin/static，
# 再用 buildx 多架构构建（见根目录 build-image.mjs）：
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -f src/backend/deploy/Dockerfile.allinone -t <registry>/market:1.0.0 --push .
#
# 基础层：ubuntu + mysql/redis + appuser 已固化为 market-base 镜像（见
# Dockerfile.base，内容哈希 tag 自动检测、低频重建），本文件只做秒级 COPY，
# 不再执行 apt，构建期无需 QEMU。CI 与 build-image.mjs 均会通过
# --build-arg BASE_IMAGE=<sha-哈希 tag> 传入精确版本；
# 下面的默认值仅作兜底（latest 随最近一次 base 构建更新）。
#
# 运行示例（数据目录需先创建，Linux 宿主无需手动 chown——entrypoint 以 root
# 引导并完成授权）：
#   docker run -d --name market --restart unless-stopped -p 18080:18080 \
#     -p 127.0.0.1:3306:3306 -p 127.0.0.1:6379:6379 \
#     （3306/6379 映射为可选调试项：宿主机端口已被占用时改宿主侧端口如 13306/16379，
#      或直接去掉这两个 -p，调试改走 docker exec）
#     -e MYSQL_ROOT_PASSWORD='<强口令>' -e MYSQL_PASSWORD='<强口令>' \
#     （MYSQL_PASSWORD 须与 MYSQL_ROOT_PASSWORD 同值显式注入：docker exec 直跑
#      ./market-admin 等工具的新 shell 不继承 entrypoint 的 export；漏配时应用
#      会回退 MYSQL_ROOT_PASSWORD，但显式注入保证各链路口径一致） \
#     -e REDIS_PASSWORD='<强口令>' -e JWT_SECRET='<随机强密钥>' -e APP_ENV=production \
#     -v /opt/market/data/mysql:/var/lib/mysql \
#     -v /opt/market/data/redis:/data \
#     -v /opt/market/data/uploads:/app/uploads \
#     -v /opt/market/data/runtime:/app/runtime \
#     -v /opt/market/data/logs:/app/logs \
#     -v /opt/market/data/geoip:/app/data/geoip \
#     （geoip 可选：缺失时 entrypoint 自动执行 ./geoip-download 下载（需目录可写，
#      故不再 :ro 挂载），下载失败仅 IP 定位优雅降级；更新可由宿主机 crontab
#      跑发布包内二进制或 docker exec 触发）
#     -v /opt/market/data/ssl:/app/data/ssl \
#     （ssl 存放登录密码加密 RSA 私钥（可选）：首启自动生成并落盘 0600，
#      不挂载则密钥在容器可写层、重建即换（前端自动重拉公钥无感知）；挂载后
#      重建容器/升级镜像 key_id 不变，多实例部署必须挂载同一宿主文件）
#     <registry>/market:1.0.0
ARG BASE_IMAGE=docker.io/jcbowen/market-base:latest
FROM ${BASE_IMAGE}

# TARGETARCH 由 BuildKit 按目标平台自动注入（amd64/arm64），从 build.mjs
# 输出的 bin/linux-{arch} 目录取对应架构产物
ARG TARGETARCH

ENV CONFIG_FILE=/app/runtime/config.market-admin.yaml \
    MARKET_ADMIN_CREDENTIALS_FILE=/app/runtime/admin_credentials.json

WORKDIR /app

COPY bin/linux-${TARGETARCH}/gateway ./gateway
COPY bin/linux-${TARGETARCH}/user-service ./user-service
COPY bin/linux-${TARGETARCH}/product-service ./product-service
COPY bin/linux-${TARGETARCH}/order-service ./order-service
COPY bin/linux-${TARGETARCH}/cart-service ./cart-service
COPY bin/linux-${TARGETARCH}/payment-service ./payment-service
COPY bin/linux-${TARGETARCH}/market-admin ./market-admin

# GeoIP 定位库下载工具（entrypoint 检测 /app/data/geoip 无 mmdb 时调用）
COPY bin/linux-${TARGETARCH}/geoip-download ./geoip-download

# 前端静态资源与配置模板打包进镜像（发布即完整可跑）
COPY bin/static ./static
COPY bin/config.allinone.yaml ./config.yaml
COPY src/backend/deploy/entrypoint.sh /entrypoint.sh

# 演示种子素材：打进镜像由网关直接服务 /uploads/seed/**（不能放 /app/uploads，
# 该目录部署时被宿主目录挂载、会遮蔽镜像内容）；演示数据本身由 market-admin init
# 经内嵌数据包导入（非 production 且空库时），不再携带 SQL 种子文件
COPY deploy/seed-assets/products ./seed/products

RUN chmod +x /entrypoint.sh ./gateway ./user-service ./product-service \
    ./order-service ./cart-service ./payment-service ./market-admin ./geoip-download

EXPOSE 18080 3306 6379

# 健康检查：网关 HTTP 端口 TCP 探活（Ubuntu 无默认 nc，用 bash /dev/tcp）；
# start-period 放宽到 120s：首启需完成 MySQL 初始化 + 各服务 AutoMigrate
HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=10 \
    CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/18080' || exit 1

ENTRYPOINT ["/entrypoint.sh"]
