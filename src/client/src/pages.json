{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/category/category",
      "style": {
        "navigationBarTitleText": "社区商超",
        "navigationStyle": "custom",
        // navigationStyle: custom 是微信端写法，支付宝端编译时被忽略导致原生导航栏出现，
        // 与页面内沉浸式布局（top: statusBarHeight）叠加成双重让位空白；
        // 支付宝端等效配置为 transparentTitle: always（导航透明、内容延伸到状态栏）
        // + titlePenetrate: YES（透明导航层点击穿透，否则搜索框上半部分点击被拦截）
        // #ifdef MP-ALIPAY
        "transparentTitle": "always",
        "titlePenetrate": "YES"
        // #endif
      }
    },
    {
      "path": "pages/search/search",
      "style": {
        "navigationBarTitleText": "搜索"
      }
    },
    {
      "path": "pages/cart/cart",
      "style": {
        "navigationBarTitleText": "购物车"
      }
    },
    {
      "path": "pages/user/user",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/login/login",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/community/select",
      "style": {
        "navigationBarTitleText": "选择社区"
      }
    },
    {
      "path": "pages/pay/result",
      "style": {
        "navigationBarTitleText": "支付结果"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pagesGoods",
      "pages": [
        {
          "path": "product/detail",
          "style": {
            "navigationBarTitleText": "商品详情"
          }
        },
        {
          "path": "flash/flash",
          "style": {
            "navigationBarTitleText": "限时秒杀"
          }
        },
        {
          "path": "full-reduction/full-reduction",
          "style": {
            "navigationBarTitleText": "满减活动"
          }
        }
      ]
    },
    {
      "root": "pagesOrder",
      "pages": [
        {
          "path": "order/confirm",
          "style": {
            "navigationBarTitleText": "确认订单"
          }
        },
        {
          "path": "order/list",
          "style": {
            "navigationBarTitleText": "我的订单"
          }
        },
        {
          "path": "order/detail",
          "style": {
            "navigationBarTitleText": "订单详情"
          }
        },
        {
          "path": "pay/alipay",
          "style": {
            "navigationBarTitleText": "支付宝支付"
          }
        }
      ]
    },
    {
      "root": "pagesMine",
      "pages": [
        {
          "path": "user/profile",
          "style": {
            "navigationBarTitleText": "个人资料"
          }
        },
        {
          "path": "address/list",
          "style": {
            "navigationBarTitleText": "收货地址"
          }
        },
        {
          "path": "address/edit",
          "style": {
            "navigationBarTitleText": "编辑地址"
          }
        },
        {
          "path": "coupon/coupon",
          "style": {
            "navigationBarTitleText": "优惠券包"
          }
        },
        {
          "path": "about/about",
          "style": {
            "navigationBarTitleText": "关于"
          }
        }
      ]
    },
    {
      "root": "pagesStaff",
      "pages": [
        {
          "path": "fulfillment/fulfillment",
          "style": {
            "navigationBarTitleText": "履约工作台"
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/category/category": {
      "network": "all",
      "packages": ["pagesGoods", "pagesOrder"]
    },
    "pages/user/user": {
      "network": "wifi",
      "packages": ["pagesMine"]
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "社区商超",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f5f5f5",
    "rpxCalcMaxDeviceWidth": 768,
    "rpxCalcBaseDeviceWidth": 375
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#07c160",
    "borderStyle": "black",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/category/category",
        "text": "首页",
        "iconPath": "static/tabbar/grid.png",
        "selectedIconPath": "static/tabbar/grid-active.png"
      },
      {
        "pagePath": "pages/cart/cart",
        "text": "购物车",
        "iconPath": "static/tabbar/cart.png",
        "selectedIconPath": "static/tabbar/cart-active.png"
      },
      {
        "pagePath": "pages/user/user",
        "text": "我的",
        "iconPath": "static/tabbar/user.png",
        "selectedIconPath": "static/tabbar/user-active.png"
      }
    ]
  },
  "uniIdRouter": {}
}
