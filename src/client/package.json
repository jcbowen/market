{
  "name": "market-frontend",
  "version": "1.0.0",
  "description": "社区商超用户端",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:mp-alipay": "uni -p mp-alipay",
    "dev:h5": "uni",
    "dev:app": "uni -p app",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-alipay": "uni build -p mp-alipay",
    "build:h5": "uni build && rm -rf ../../bin/static/h5 && mv dist/build/h5 ../../bin/static/h5 && rm -rf dist",
    "build:app": "uni build -p app"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-alipay": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020120260710001",
    "js-cookie": "^3.0.5",
    "pinia": "^2.1.7",
    "uview-plus": "^3.1.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.0",
    "@types/js-cookie": "^3.0.6",
    "@dcloudio/uni-automator": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5020120260710001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5020120260710001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020120260710001",
    "sass": "^1.69.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}