    "build:mp-alipay": "node scripts/gen-tab-bar-paths.js && uni build -p mp-alipay",
    "build:h5": "node scripts/gen-tab-bar-paths.js && uni build && node scripts/build-h5.js",
    "build:app": "node scripts/gen-tab-bar-paths.js && uni build -p app",
    "type-check": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
