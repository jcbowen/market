{
	"version": "2.0.0",
	"inputs": [
		{
			"id": "startMode",
			"type": "pickString",
			"description": "start-all 启动模式",
			"default": "",
			"options": [
				{
					"label": "常规启动（保留 MySQL/Redis 数据）",
					"value": ""
				},
				{
					"label": "清理 MySQL/Redis 数据后重启（--clean）",
					"value": "--clean"
				},
				{
					"label": "跳过构建，直接使用已有镜像/二进制（--skip-build）",
					"value": "--skip-build"
				},
				{
					"label": "快速模式：后端仅编译当前容器平台（--fast）",
					"value": "--fast"
				},
				{
					"label": "快速构建 + 清理 MySQL/Redis 数据（--fast --clean）",
					"value": "--fast --clean"
				},
				{
					"label": "构建镜像不使用 Docker 缓存（--no-cache）",
					"value": "--no-cache"
				},
				{
					"label": "构建后端前拉取本地依赖最新代码（--pull-deps）",
					"value": "--pull-deps"
				},
				{
					"label": "快速模式 + 拉取本地依赖（--fast --pull-deps）",
					"value": "--fast --pull-deps"
				}
			]
		}
	],
	"tasks": [
		{
			"type": "shell",
			"label": "start-all（Docker 一键启动）",
			"command": "node start-all.mjs ${input:startMode}",
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"detail": "依赖检查 → 前后端构建 → 镜像构建 → 启动服务 → 初始化数据（首次会弹出启动模式选择）"
		},
		{
			"type": "shell",
			"label": "pull-deps（拉取本地依赖最新代码）",
			"command": "node pull-deps.mjs",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"detail": "读取 src/backend/go.mod 的本地 replace，逐个 git pull --ff-only；有未提交改动的仓库跳过并提示"
		},
		{
			"type": "shell",
			"label": "build-select（交互式编译打包）",
			"command": "node build-select.mjs",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"detail": "在任务终端内按编号选择编译模块（admin/H5/backend/docker/微信/支付宝小程序），可选打包 bin/release"
		},
		{
			"type": "shell",
			"label": "构建微信小程序",
			"command": "npm run build:mp-weixin",
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"options": {
				"cwd": "${workspaceFolder}/src/client"
			},
			"detail": "appid 从 manifest.local.json 或 --appid 注入（缺失报错）；产物 dist/build/mp-weixin，用微信开发者工具导入上传"
		},
		{
			"type": "shell",
			"label": "构建支付宝小程序",
			"command": "npm run build:mp-alipay",
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"options": {
				"cwd": "${workspaceFolder}/src/client"
			},
			"detail": "manifest 无 appid、上传时由开发者工具指定；产物 dist/build/mp-alipay"
		},
		{
			"label": "构建全部小程序（微信+支付宝）",
			"dependsOn": [
				"构建微信小程序",
				"构建支付宝小程序"
			],
			"dependsOrder": "sequence",
			"problemMatcher": [],
			"group": "build",
			"detail": "串行执行微信、支付宝两个小程序构建任务"
		}
	]
}