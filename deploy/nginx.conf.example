# Nginx 示例配置
# 将 market.jiuchet.com 的 /s 映射到 C 端 H5 与 API，/b 映射到管理端与 admin API
# 使用前请替换域名、SSL 证书路径及 upstream 地址

upstream market_gateway {
    server 127.0.0.1:18080;
}

server {
    listen 80;
    listen [::]:80;
    server_name market.jiuchet.com;

    # 强制 HTTPS：生产环境必须开启（登录/改密接口已启用 RSA 密文传输，但 TLS 才是防中间人的根本）；
    # 网关侧另有兜底：APP_ENV=production 时密码类接口直接拒绝非 HTTPS 请求（返回 11011）。
    # ACME HTTP-01 证书签发/续期走 80 端口明文，须在 301 之前放行例外
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    return 301 https://$host$request_uri;

    # ---- 以下 location 在开启上面的 301 后不再生效，保留作为 HTTP 调试回退参考 ----
    # （调试时注释掉 return，并按需放开下方 location）

    # C 端 H5 静态资源
    location /s/ {
        alias /path/to/market/bin/static/h5/;
        try_files $uri $uri/ /s/index.html;
        index index.html;
    }

    # 管理端静态资源
    location /b/ {
        alias /path/to/market/bin/static/admin/;
        try_files $uri $uri/ /b/index.html;
        index index.html;
    }

    # C 端 API
    location /api/v1/ {
        proxy_pass http://market_gateway/api/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 管理端 API（真实前缀是 /api/v1/admin，网关未注册 /api/admin 路由）
    location /api/v1/admin/ {
        proxy_pass http://market_gateway/api/v1/admin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 后台新订单语音通知的 WebSocket 长连接（GET /api/v1/admin/ws）
    # 必须单列一个 location：nginx 默认按 HTTP/1.0 回源且丢掉 Connection 头，Upgrade 无法透传，
    # 握手会退化成普通 200 响应；proxy_read_timeout 也须放开，否则空闲 60s 即被掐断
    # Host 一律用 $host（不得改成源站域名/IP）：网关按「Origin 主机名 == 请求主机名」判定同源，
    # 回源 Host 变了就会被判跨源拒绝；经 CDN/DCDN/ESA 接入时同理，回源 Host 须保持加速域名
    location /api/v1/admin/ws {
        proxy_pass http://market_gateway;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # 支付回调（建议单独配置，避免被静态路由拦截）
    location /api/v1/payments/callback/ {
        proxy_pass http://market_gateway/api/v1/payments/callback/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# HTTPS 主配置（生产环境将上节 301 指向本节；X-Forwarded-Proto 传 https 是网关
# 密码类接口 HTTPS 兜底判定的依据，务必保留）
# 经 CDN/DCDN/ESA 前置时还须设置动态回源协议：DCDN 的「动态内容协议跟随回源」在
# 「动静态加速规则 → 动态内容回源配置」页（不在「回源配置」页），未设置时默认
# 跟随源站端口（80 → HTTP 明文回源），登录等密码类接口会被网关兜底拒绝（11011）
server {
    # nginx ≥ 1.25.1 用 http2 指令（旧写法 listen ... http2 已弃用，新版仅告警）；
    # 旧版 nginx（< 1.25.1）请改回 listen 443 ssl http2;
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name market.jiuchet.com;

    # 证书（Let's Encrypt 或云厂商签发；与登录加密的 RSA 密钥对无关，两者互不影响）
    ssl_certificate /path/to/cert.pem;
    ssl_certificate_key /path/to/key.pem;
    # 仅保留安全协议版本与主流加密套件
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # HSTS：一年内浏览器强制走 HTTPS（includeSubDomains 覆盖子域——子域也须全程 HTTPS，
    # 若存在纯 HTTP 子域请去掉该参数；确认证书续期稳定后再开启 preload）
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # C 端 H5 静态资源
    location /s/ {
        alias /path/to/market/bin/static/h5/;
        try_files $uri $uri/ /s/index.html;
        index index.html;
    }

    # 管理端静态资源
    location /b/ {
        alias /path/to/market/bin/static/admin/;
        try_files $uri $uri/ /b/index.html;
        index index.html;
    }

    # C 端 API
    location /api/v1/ {
        proxy_pass http://market_gateway/api/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 管理端 API（真实前缀是 /api/v1/admin，网关未注册 /api/admin 路由）
    location /api/v1/admin/ {
        proxy_pass http://market_gateway/api/v1/admin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 后台 WebSocket：透传要求同上方说明（Upgrade/Connection/长超时/Host 用 $host）
    location /api/v1/admin/ws {
        proxy_pass http://market_gateway;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # 支付回调
    location /api/v1/payments/callback/ {
        proxy_pass http://market_gateway/api/v1/payments/callback/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
