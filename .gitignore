# === 依赖 ===
node_modules/
.pnpm-store/

# === 编译产物 ===
# bin/ 整目录忽略会让父目录排除语义吞掉所有子路径（否定规则失效），
# 改用 bin/* 逐项忽略，保留配置模板入库
bin/*
!bin/config.docker.yaml
!bin/config.yaml
# 一体化镜像（all-in-one）配置模板：地址为 127.0.0.1，见 docs 部署方案
!bin/config.allinone.yaml
*.exe
*.dll
*.so
*.dylib

# === Go ===
# go.sum 与 go.mod 一并提交，保证依赖可重现
# pkg/ 为 GOPATH/pkg，仅存放 go mod tidy 下载的第三方依赖缓存
pkg/*
!pkg/.gitkeep

# === 后端构建产物 ===
bin/gateway
bin/*-service
bin/logs/
bin/release/
# IP 定位数据库（GeoLite2-City 等 mmdb）：由 download-geoip.mjs 下载更新，不入仓库
*.mmdb
*.mmdb.gz
/cart
/order
/payment
/product
/user
/gateway

# === IDE ===
.idea/
.vscode/
.workbuddy/
*.swp
*.swo
*~

# === macOS ===
.DS_Store
.AppleDouble
.LSOverride
._*

# === 环境变量 ===
.env
.env.local
.env.*.local

# === 小程序本机构建覆盖（卖方专用，见 src/client/scripts/build-mp.js）===
src/client/src/manifest.local.json
src/client/src/.manifest.json.bak

# === 日志 ===
*.log
npm-debug.log*

# === 临时文件 ===
*.tmp
*.temp
.cache/
# all-in-one 镜像本地验证的临时数据目录（可随时手动删除）
.tmp-allinone-test*/

# === Playwright 测试产物 ===
test-results/

# === 测试脚本生成的截图 ===
/scripts

# === uni-app ===
unpackage/
src/client/dist/

# === 其他 ===
Thumbs.db
# === 本地临时预览与工具产物（2026-10 审查补充） ===
.tmp-picker-preview/
generated-images/
.playwright-cli/
config.debugtest.yaml
