# === 依赖 ===
node_modules/
.pnpm-store/

# === 编译产物 ===
# bin/ 整目录忽略会让父目录排除语义吞掉所有子路径（否定规则失效），
# 改用 bin/* 逐项忽略，保留配置模板入库
bin/*
!bin/config.docker.yaml
!bin/config.yaml
*.exe
*.dll
*.so
*.dylib

# === Go ===
# go.sum 与 go.mod 一并提交，保证依赖可重现
# pkg/ 为 GOPATH/pkg，仅存放 go mod tidy 下载的第三方依赖缓存
pkg/*
!pkg/.gitkeep

# === 后端构建产物 ===
bin/gateway
bin/*-service
bin/logs/
bin/release/
# IP 定位数据库（GeoLite2-City 等 mmdb）：由 download-geoip.mjs 下载更新，不入仓库
*.mmdb
*.mmdb.gz
/cart
/order
/payment
/product
/user
/gateway

# === IDE ===
.idea/
.vscode/
.workbuddy/
*.swp
*.swo
*~

# === macOS ===
.DS_Store
.AppleDouble
.LSOverride
._*

# === 环境变量 ===
.env
.env.local
.env.*.local

# === 日志 ===
*.log
npm-debug.log*

# === 临时文件 ===
*.tmp
*.temp
.cache/

# === Playwright 测试产物 ===
test-results/

# === 测试脚本生成的截图 ===
/scripts

# === uni-app ===
unpackage/
src/client/dist/

# === 其他 ===
Thumbs.db